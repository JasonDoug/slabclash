// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  username              String             @unique
  email                 String             @unique
  passwordHash          String
  reputationScore       Int                @default(0)
  inAppCurrencyBalance  Int                @default(1000)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  scanJobs              CardIngestionJob[]
  cards                 Card[]
  lineups               Lineup[]
}

enum IngestionStatus {
  uploaded
  processing
  awaiting_user_confirm
  verified
  flagged
}

enum ConditionReported {
  mint
  near_mint
  excellent
  good
  fair
  poor
}

enum Rarity {
  common
  uncommon
  rare
  ultra_rare
  secret_rare
}

model Player {
  id    String @id @default(uuid())
  name  String @unique
  cards Card[]
}

model Card {
  id                   String          @id @default(uuid())
  user                 User            @relation(fields: [userId], references: [id])
  userId               String
  player               Player          @relation(fields: [playerId], references: [id])
  playerId             String
  year                 Int
  setName              String
  variant              String?
  serialNumber         String?
  conditionReported    ConditionReported
  conditionEstimatedScore Int?
  playerStats          Float?
  marketValueCents     Int?
  rarity               Rarity
  powerScore           Int?
  ratingConfigVersion  String?
  provenance           Json?
  imageFrontKey        String
  imageBackKey         String?
  phash                String?
  ingestionStatus      IngestionStatus  @default(verified)
  createdAt            DateTime        @default(now())
  ratingJobs           RatingJob[]
}

model CardIngestionJob {
  id             String          @id @default(uuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  imageFrontKey  String?
  imageBackKey   String?
  status         IngestionStatus @default(uploaded)
  ocrText        String?
  phash          String?
  candidateMatches Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model RatingJob {
  id        String   @id @default(uuid())
  card      Card     @relation(fields: [cardId], references: [id])
  cardId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model RatingConfig {
  id                  String   @id @default(uuid())
  version             String   @unique
  isActive            Boolean  @default(false)
  weights             Json
  normalizationBounds Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Lineup {
  id                   String   @id @default(uuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String
  name                 String
  slots                Json
  aggregatePowerScore  Float    @default(0)
  aggregateMomentum   Float    @default(0)
  rarityCounts         Json
  createdAt            DateTime @default(now())
  matchesAsA           Match[]  @relation("LineupA")
  matchesAsB           Match[]  @relation("LineupB")

  @@index([userId])
}

enum MatchType {
  casual
  ranked
}

enum MatchStatus {
  pending
  in_progress
  completed
  cancelled
}

model Match {
  id                 String     @id @default(uuid())
  lineupA            Lineup     @relation("LineupA", fields: [lineupAId], references: [id])
  lineupAId          String
  lineupB            Lineup     @relation("LineupB", fields: [lineupBId], references: [id])
  lineupBId          String
  matchType          MatchType
  status             MatchStatus @default(pending)
  matchSeed          String
  winnerLineupId     String?
  resolutionResults  Json?
  createdAt          DateTime   @default(now())
  completedAt        DateTime?

  @@index([lineupAId])
  @@index([lineupBId])
}
