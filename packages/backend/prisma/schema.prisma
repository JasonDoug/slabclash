// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  username              String             @unique
  email                 String             @unique
  passwordHash          String
  reputationScore       Int                @default(0)
  inAppCurrencyBalance  Int                @default(1000)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  scanJobs              CardIngestionJob[]
  cards                 Card[]
}

enum IngestionStatus {
  uploaded
  processing
  awaiting_user_confirm
  verified
  flagged
}

enum ConditionReported {
  mint
  near_mint
  excellent
  good
  fair
  poor
}

enum Rarity {
  common
  uncommon
  rare
  ultra_rare
  secret_rare
}

model Player {
  id    String @id @default(uuid())
  name  String @unique
  cards Card[]
}

model Card {
  id                   String          @id @default(uuid())
  user                 User            @relation(fields: [userId], references: [id])
  userId               String
  player               Player          @relation(fields: [playerId], references: [id])
  playerId             String
  year                 Int
  setName              String
  variant              String?
  serialNumber         String?
  conditionReported    ConditionReported
  conditionEstimatedScore Int?
  marketValueCents     Int?
  rarity               Rarity
  powerScore           Int?
  provenance           Json?
  imageFrontKey        String
  imageBackKey         String?
  phash                String?
  ingestionStatus      IngestionStatus  @default(verified)
  createdAt            DateTime        @default(now())
  ratingJobs           RatingJob[]
}

model CardIngestionJob {
  id             String          @id @default(uuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  imageFrontKey  String?
  imageBackKey   String?
  status         IngestionStatus @default(uploaded)
  ocrText        String?
  phash          String?
  candidateMatches Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model RatingJob {
  id        String   @id @default(uuid())
  card      Card     @relation(fields: [cardId], references: [id])
  cardId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
